{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user profile, role, 7-day trial start timestamp, and Google Play subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["STUDENT", "TEACHER", "ADMIN"] },
        "standard": { "type": "integer" },
        "trialStartMillis": { "type": "integer" },
        "subscriptionActive": { "type": "boolean" },
        "subscriptionAutoRenewing": { "type": "boolean" },
        "subscriptionProductId": { "type": "string" },
        "subscriptionOrderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Question": {
      "title": "Question",
      "description": "A quiz question supporting single-choice or multiple-choice formats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "stdId": { "type": "integer" },
        "subjectId": { "type": "string" },
        "unitId": { "type": "integer" },
        "type": { "type": "string" },
        "questionText": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "mediaRes": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "questionText", "correctAnswer"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "User quiz session completion result",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "unitId": { "type": "integer" },
        "score": { "type": "integer" },
        "accuracy": { "type": "integer" },
        "timestamp": { "type": "integer" }
      },
      "required": ["userId", "score"]
    },
    "Student": {
      "title": "Student",
      "description": "Student user profile and progress records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "standard": { "type": "integer" },
        "coins": { "type": "integer" },
        "stars": { "type": "integer" },
        "xp": { "type": "integer" },
        "avatar": { "type": "string" },
        "attendanceStreak": { "type": "integer" },
        "lastSyncedAt": { "type": "integer" }
      },
      "required": ["name", "standard"]
    },
    "BattleRoom": {
      "title": "BattleRoom",
      "description": "Live 1 vs 1 multiplayer quiz duel room synchronized via Firestore",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomCode": { "type": "string" },
        "hostUid": { "type": "string" },
        "player2Uid": { "type": "string" },
        "participantUids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isPrivate": { "type": "boolean" },
        "subject": { "type": "string" },
        "standard": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": ["WAITING", "IN_PROGRESS", "ROUND_REVEAL", "COMPLETED", "CANCELLED"]
        },
        "currentRound": { "type": "integer" },
        "roundStartTime": { "type": "integer" },
        "questions": { "type": "array" },
        "player1": { "type": "object" },
        "player2": { "type": "object" },
        "winnerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "roomCode", "hostUid", "participantUids", "status", "standard", "player1"]
    },
    "GlobalLeaderboardEntry": {
      "title": "GlobalLeaderboardEntry",
      "description": "PII-free public student XP ranking entry displayed on the dashboard Global Leaderboard",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "standard": { "type": "integer" },
        "avatar": { "type": "string" },
        "xp": { "type": "integer" },
        "stars": { "type": "integer" },
        "attendanceStreak": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp written via FieldValue.serverTimestamp()" }
      },
      "required": ["uid", "displayName", "standard", "xp", "updatedAt"]
    },
    "KpscStudyMaterial": {
      "title": "KpscStudyMaterial",
      "description": "KPSC exam preparation study material and synchronized MCQ quiz bundle per subject module and unit",
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "enum": [
            "kpsc_kannada",
            "kpsc_english",
            "kpsc_gk",
            "kpsc_science",
            "kpsc_kannada_grammar",
            "kpsc_computer",
            "karnataka_history",
            "indian_polity",
            "geography_economy",
            "general_science",
            "mental_ability"
          ]
        },
        "unitId": { "type": "integer" },
        "unitName": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "contentMarkdown": { "type": "string" },
        "language": { "type": "string", "enum": ["kn", "en", "bilingual"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "examTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "questions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "contentVersion": { "type": "integer" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "unitId", "unitName", "title", "language", "difficulty", "contentVersion", "published", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Authenticated user account, trial timestamp, and subscription status"
    },
    "/users/{userId}/quiz_results/{resultId}": {
      "schema": "QuizResult",
      "description": "User quiz attempt history"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student profile, progress and achievements"
    },
    "/students/{studentId}/unit_progress/{unitId}": {
      "schema": "QuizResult",
      "description": "Student per-unit mastery progress"
    },
    "/students/{studentId}/historical_scores/{scoreId}": {
      "schema": "QuizResult",
      "description": "Student historical quiz scores"
    },
    "/global_leaderboard/{studentId}": {
      "schema": "GlobalLeaderboardEntry",
      "description": "Public PII-free global student leaderboard ranked by total accumulated XP"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Central collection of quiz questions"
    },
    "/quiz_questions/{questionId}": {
      "schema": "Question",
      "description": "Legacy/mirrored collection of custom quiz questions"
    },
    "/kpsc_study_materials/{materialId}": {
      "schema": "KpscStudyMaterial",
      "description": "KPSC exam preparation study materials and synchronized subject-module quiz bundles"
    },
    "/battle_rooms/{roomId}": {
      "schema": "BattleRoom",
      "description": "Real-time 1 vs 1 multiplayer battle arena rooms"
    }
  }
}
